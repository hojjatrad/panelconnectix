<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- v4.0.24 ULTRA DEEP FIX - All paths for reliable APK install + Play Protect dialog -->
    <!-- External files = primary for FileProvider (best compat) -->
    <external-files-path name="connectix_external_files" path="." />
    <external-files-path name="connectix_external_files_download" path="Download/" />
    <!-- External path = public storage including Downloads (triggers Play Protect 'Install without scanning') -->
    <external-path name="connectix_external_path" path="." />
    <external-path name="connectix_external_download" path="Download/" />
    <!-- Cache paths fallback -->
    <cache-path name="connectix_cache" path="." />
    <external-cache-path name="connectix_external_cache" path="." />
    <!-- Internal files fallback -->
    <files-path name="connectix_files" path="." />
    <!-- Media path for Android 10+ -->
    <external-media-path name="connectix_external_media" path="." />
</paths>
